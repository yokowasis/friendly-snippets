{
    "typetemplate": {
        "prefix": "tyt",
        "body": [
            "/**",
            " * @template T",
            " * @typedef ${1:TypeName}",
            " * @type {{a : string}}",
            " */"
        ]
    },
    "typeimport": {
        "prefix": "typeimport",
        "body": ["/**", " * @typedef { import(\"${1:./Types.js}\")}", " */"]
    }
}
