{
    "next.js-launchjson": {
        "prefix": "next.js-launchjson",
        "body": [
            "{",
            "\t\"version\": \"0.2.0\",",
            "\t\"configurations\": [",
            "\t\t{",
            "\t\t\t\"name\": \"Next.js: debug server-side\",",
            "\t\t\t\"type\": \"node-terminal\",",
            "\t\t\t\"request\": \"launch\",",
            "\t\t\t\"command\": \"npm run dev\"",
            "\t\t},",
            "\t\t{",
            "\t\t\t\"name\": \"Next.js: debug client-side\",",
            "\t\t\t\"type\": \"chrome\",",
            "\t\t\t\"request\": \"launch\",",
            "\t\t\t\"url\": \"http://localhost:3000\"",
            "\t\t}",
            "\t],",
            "\t\"compounds\": [",
            "\t\t{",
            "\t\t\t\"name\": \"Full Stack\",",
            "\t\t\t\"configurations\": [",
            "\t\t\t\t\"Next.js: debug server-side\",",
            "\t\t\t\t\"Next.js: debug client-side\"",
            "\t\t\t]",
            "\t\t}",
            "\t]",
            "}",
            ""
        ]
    },
    "nodelaunchjson": {
        "prefix": "nodelaunchjson",
        "body": [
            "{",
            "\t\"name\": \"Launch Program\",",
            "\t\"type\": \"node\",",
            "\t\"request\": \"launch\",",
            "\t\"program\": \"${workspaceFolder}/app.js\",",
            "\t\"skipFiles\": [\"<node_internals>/**\"]",
            "}",
            ""
        ]
    },
    "tsconfig": {
        "prefix": "tsconfig",
        "body": [
            "{",
            "\t\"compilerOptions\": {",
            "\t\t\"target\": \"ES2022\",",
            "\t\t\"module\": \"NodeNext\",",
            "\t\t\"moduleResolution\": \"NodeNext\",",
            "",
            "\t\t\"outDir\": \"./dist\",",
            "\t\t\"rootDir\": \"./\",",
            "",
            "\t\t\"strict\": true,",
            "",
            "\t\t\"esModuleInterop\": true,",
            "\t\t\"forceConsistentCasingInFileNames\": true,",
            "\t\t\"skipLibCheck\": true,",
            "",
            "\t\t\"resolveJsonModule\": true,",
            "",
            "\t\t\"types\": [\"node\"]",
            "\t},",
            "\t\"include\": [\"./\"],",
            "\t\"exclude\": [\"node_modules\"]",
            "}",
            ""
        ]
    },
    "pb-launchjson": {
        "prefix": "pb-launchjson",
        "body": [
            "{",
            "\t// Use IntelliSense to learn about possible attributes.",
            "\t// Hover to view descriptions of existing attributes.",
            "\t// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387",
            "\t\"version\": \"0.2.0\",",
            "\t\"configurations\": [",
            "\t\t{",
            "\t\t\t\"name\": \"Launch PocketBase (serve)\",",
            "\t\t\t\"type\": \"go\",",
            "\t\t\t\"request\": \"launch\",",
            "\t\t\t\"mode\": \"debug\",",
            "\t\t\t\"program\": \"\\${workspaceFolder}\",",
            "\t\t\t\"cwd\": \"\\${workspaceFolder}\",",
            "\t\t\t\"args\": [\"serve\", \"--dev\"]",
            "\t\t}",
            "\t]",
            "}",
            ""
        ]
    },
    "svelte-launchjson": {
        "prefix": "svelte-launchjson",
        "body": [
            "{",
            "\t\"version\": \"0.2.0\",",
            "\t\"configurations\": [",
            "\t\t{",
            "\t\t\t\"name\": \"Launch server\",",
            "\t\t\t\"request\": \"launch\",",
            "\t\t\t\"runtimeArgs\": [\"run-script\", \"dev\"],",
            "\t\t\t\"runtimeExecutable\": \"npm\",",
            "\t\t\t\"skipFiles\": [\"<node_internals>/**\"],",
            "\t\t\t\"type\": \"node\",",
            "\t\t\t\"console\": \"integratedTerminal\"",
            "\t\t},",
            "\t\t{",
            "\t\t\t\"type\": \"chrome\",",
            "\t\t\t\"request\": \"launch\",",
            "\t\t\t\"name\": \"Launch Chrome\",",
            "\t\t\t\"url\": \"http://localhost:5173\",",
            "\t\t\t\"webRoot\": \"\\${workspaceFolder}\",",
            "\t\t\t\"skipFiles\": [\"\\${workspaceFolder}/node_modules/**/*.js\"]",
            "\t\t}",
            "\t],",
            "\t\"compounds\": [",
            "\t\t{",
            "\t\t\t\"name\": \"Full Stack\",",
            "\t\t\t\"configurations\": [\"Launch server\", \"Launch Chrome\"]",
            "\t\t}",
            "\t]",
            "}",
            ""
        ]
    }
}
