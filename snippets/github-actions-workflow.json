{
    "github-private": {
        "prefix": "github-private",
        "body": [
            "      - name: Configure git to use GitHub token for private dependencies",
            "        run: |",
            "          git config --global url.\"https://\\${{ secrets.GH_TOKEN }}@github.com/\".insteadOf \"https://github.com/\"",
            "          git config --global --add url.\"https://\\${{ secrets.GH_TOKEN }}@github.com/\".insteadOf \"git@github.com:\"",
            "          git config --global --add url.\"https://\\${{ secrets.GH_TOKEN }}@github.com/\".insteadOf \"ssh://git@github.com/\"",
            ""
        ]
    },
    "pnpm": {
        "prefix": "pnpm",
        "body": [
            "- uses: pnpm/setup@v1",
            "  with:",
            "    version: 11",
            "    runtime: node@24",
            "    cache: true"
        ]
    },
    "GithubActionPingURL": {
        "prefix": "GithubActionPingURL",
        "body": [
            "# name : .github/workflows/ping.yml",
            "name: Deploy to host2",
            "on:",
            "  push:",
            "    branches:",
            "      - \"main\"",
            "    paths-ignore:",
            "      - \"**/*.md\"",
            "      - \"**/*.mjs\"",
            "      - \"**/ping.yml\"",
            "jobs:",
            "  build:",
            "    runs-on: ubuntu-latest",
            "    steps:",
            "      - name: PING",
            "        run: curl https://deploy.host2.bimasoft.web.id/svelte-cbtadmin",
            ""
        ]
    },
    "GithubActionPagesNextJS": {
        "prefix": "GithubActionPagesNextJS",
        "body": [
            "# name : .github/workflows/ping.yml",
            "name: Deploy to GitHub Pages",
            "on:",
            "  push:",
            "    branches:",
            "      - \"viteBranch\"",
            "    paths-ignore:",
            "      - \"**/*.md\"",
            "      - \"**/*.mjs\"",
            "      # - \"**/ping.yml\"",
            "permissions:",
            "  contents: read",
            "  pages: write",
            "  id-token: write",
            "concurrency:",
            "  group: \"pages\"",
            "  cancel-in-progress: false",
            "jobs:",
            "  build:",
            "    runs-on: ubuntu-latest",
            "    steps:",
            "      - name: Checkout Repository",
            "        uses: actions/checkout@v4",
            "        with:",
            "          submodules: recursive",
            "      - uses: pnpm/action-setup@v2",
            "        with:",
            "          version: 8",
            "      - name: Detect package manager",
            "        id: detect-package-manager",
            "        run: |",
            "          if [ -f \"${{ github.workspace }}/yarn.lock\" ]; then",
            "            echo \"manager=yarn\" >> \\$GITHUB_OUTPUT",
            "            echo \"command=install\" >> \\$GITHUB_OUTPUT",
            "            echo \"runner=yarn\" >> \\$GITHUB_OUTPUT",
            "            exit 0",
            "          elif [ -f \"${{ github.workspace }}/pnpm-lock.yaml\" ]; then",
            "            echo \"manager=pnpm\" >> \\$GITHUB_OUTPUT",
            "            echo \"command=install\" >> \\$GITHUB_OUTPUT",
            "            echo \"runner=pnpm\" >> \\$GITHUB_OUTPUT",
            "            exit 0",
            "          elif [ -f \"${{ github.workspace }}/package.json\" ]; then",
            "            echo \"manager=npm\" >> \\$GITHUB_OUTPUT",
            "            echo \"command=ci\" >> \\$GITHUB_OUTPUT",
            "            echo \"runner=npx --no-install\" >> \\$GITHUB_OUTPUT",
            "            exit 0",
            "          else",
            "            echo \"Unable to determine package manager\"",
            "            exit 1",
            "          fi",
            "      - name: Setup Node",
            "        uses: actions/setup-node@v4",
            "        with:",
            "          node-version: \"20\"",
            "          cache: ${{ steps.detect-package-manager.outputs.manager }}",
            "      - name: Configure git to use GitHub token for private dependencies",
            "        run: git config --global url.\"https://${{ secrets.GH_TOKEN }}@github.com/\".insteadOf \"https://github.com/\"",
            "      - name: Install dependencies",
            "        run: ${{ steps.detect-package-manager.outputs.manager }} ${{ steps.detect-package-manager.outputs.command }}",
            "      - name: Build project",
            "        run: ${{ steps.detect-package-manager.outputs.runner }} run build",
            "      - name: Upload artifact",
            "        uses: actions/upload-pages-artifact@v2",
            "        with:",
            "          path: ./dist",
            "  # Deployment job",
            "  deploy:",
            "    environment:",
            "      name: github-pages",
            "      url: ${{ steps.deployment.outputs.page_url }}",
            "    runs-on: ubuntu-latest",
            "    needs: build",
            "    steps:",
            "      - name: Deploy to GitHub Pages",
            "        id: deployment",
            "        uses: actions/deploy-pages@v3"
        ]
    },
    "githubactions3upload": {
        "prefix": "githubactions3upload",
        "body": [
            "name: Build & Upload Next.js Static to S3-Compatible",
            "",
            "on:",
            "\tpush:",
            "\t\tbranches: [main]",
            "\tworkflow_dispatch:",
            "",
            "permissions:",
            "\tcontents: read",
            "",
            "jobs:",
            "\tbuild-and-upload:",
            "\t\truns-on: ubuntu-latest",
            "",
            "\t\tsteps:",
            "\t\t\t- name: Checkout repository",
            "\t\t\t\tuses: actions/checkout@v4",
            "",
            "\t\t\t- name: Setup Node.js",
            "\t\t\t\tuses: actions/setup-node@v4",
            "\t\t\t\twith:",
            "\t\t\t\t\tnode-version: \"24\"",
            "\t\t\t\t\tcache: \"npm\"",
            "",
            "\t\t\t- name: Install dependencies",
            "\t\t\t\trun: npm ci",
            "",
            "\t\t\t- name: Build static Next.js site",
            "\t\t\t\trun: npm run build",
            "",
            "\t\t\t- name: Create ZIP archive",
            "\t\t\t\trun: zip -r website-sekolah.zip out/",
            "",
            "\t\t\t- name: Upload to S3-Compatible Storage",
            "\t\t\t\tenv:",
            "\t\t\t\t\tAWS_ACCESS_KEY_ID: ${{ secrets.S3_ACCESS_KEY_ID }}",
            "\t\t\t\t\tAWS_SECRET_ACCESS_KEY: ${{ secrets.S3_SECRET_ACCESS_KEY }}",
            "\t\t\t\t\tAWS_DEFAULT_REGION: ${{ vars.S3_REGION }}",
            "\t\t\t\t\tAWS_EC2_METADATA_DISABLED: true # Prevents AWS CLI from hanging on metadata checks",
            "\t\t\t\t\tS3_ENDPOINT_URL: ${{ secrets.S3_ENDPOINT_URL }}",
            "\t\t\t\t\tS3_BUCKET: ${{ secrets.S3_BUCKET }}",
            "\t\t\t\trun: |",
            "\t\t\t\t\taws s3 cp website-sekolah.zip s3://${S3_BUCKET}/website-sekolah.zip \\",
            "\t\t\t\t\t\t--endpoint-url ${S3_ENDPOINT_URL} \\",
            "\t\t\t\t\t\t--no-progress",
            ""
        ]
    }
}
