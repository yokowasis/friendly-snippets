{
    "MAUI ScrollView": {
        "prefix": "mauiscrollview",
        "description": "MAUI ScrollView with common properties",
        "body": [
            "<ScrollView x:Name=\"${1:myScrollView}\"",
            "            Orientation=\"${2|Vertical,Horizontal,Both|}\"",
            "            Padding=\"${3:16}\">",
            "    $0",
            "</ScrollView>"
        ]
    },
    "MAUI VerticalStackLayout": {
        "prefix": "mauivstack",
        "description": "MAUI VerticalStackLayout with common properties",
        "body": [
            "<VerticalStackLayout x:Name=\"${1:myVerticalStack}\"",
            "                     Spacing=\"${2:8}\"",
            "                     Padding=\"${3:16}\"",
            "                     HorizontalOptions=\"${4|Fill,Start,Center,End|}\">",
            "    $0",
            "</VerticalStackLayout>"
        ]
    },
    "MAUI HorizontalStackLayout": {
        "prefix": "mauihstack",
        "description": "MAUI HorizontalStackLayout with common properties",
        "body": [
            "<HorizontalStackLayout x:Name=\"${1:myHorizontalStack}\"",
            "                       Spacing=\"${2:8}\"",
            "                       Padding=\"${3:16}\"",
            "                       VerticalOptions=\"${4|Center,Fill,Start,End|}\">",
            "    $0",
            "</HorizontalStackLayout>"
        ]
    },
    "MAUI Label": {
        "prefix": "mauilabel",
        "description": "MAUI Label with common properties including horizontal alignment",
        "body": [
            "<Label x:Name=\"${1:myLabel}\"",
            "       Text=\"${2:Hello, World!}\"",
            "       FontSize=\"${3:16}\"",
            "       TextColor=\"${4:Black}\"",
            "       HorizontalTextAlignment=\"${5|Center,Start,End,Justify|}\"",
            "       HorizontalOptions=\"${6|Fill,Center,Start,End|}\"",
            "       FontAttributes=\"${7|None,Bold,Italic|}\" />$0"
        ]
    },
    "MAUI Button": {
        "prefix": "mauibutton",
        "description": "MAUI Button with common properties",
        "body": [
            "<Button x:Name=\"${1:myButton}\"",
            "        Text=\"${2:Click Me}\"",
            "        Clicked=\"${3:OnButtonClicked}\"",
            "        BackgroundColor=\"${4:#512BD4}\"",
            "        TextColor=\"${5:White}\"",
            "        HorizontalOptions=\"${6|Fill,Start,Center,End|}\"",
            "        CornerRadius=\"${7:8}\" />$0"
        ]
    },
    "MAUI Picker (Select)": {
        "prefix": "mauiselect",
        "description": "MAUI Picker dropdown (equivalent of HTML select)",
        "body": [
            "<Picker x:Name=\"${1:myPicker}\"",
            "        Title=\"${2:Select an option}\"",
            "        SelectedIndexChanged=\"${3:OnPickerSelectedIndexChanged}\"",
            "        HorizontalOptions=\"${4|Fill,Start,Center,End|}\" />$0"
        ]
    },
    "MAUI Picker Static Options (Select)": {
        "prefix": "mauiselectstatic",
        "description": "MAUI Picker dropdown with static items",
        "body": [
            "<Picker x:Name=\"${1:myPicker}\"",
            "        Title=\"${2:Select an option}\"",
            "        SelectedIndex=\"${3:0}\"",
            "        HorizontalOptions=\"${4|Fill,Start,Center,End|}\">",
            "    <Picker.ItemsSource>",
            "        <x:Array Type=\"{x:Type x:String}\">",
            "            <x:String>${5:Option 1}</x:String>",
            "            <x:String>${6:Option 2}</x:String>",
            "        </x:Array>",
            "    </Picker.ItemsSource>",
            "</Picker>$0"
        ]
    },
    "MAUI Entry (InputText)": {
        "prefix": ["inputtext", "mauiinput", "mauiinputtext", "mauientry"],
        "description": "MAUI Entry text input (equivalent of HTML input text)",
        "body": [
            "<Entry x:Name=\"${1:myEntry}\"",
            "       Placeholder=\"${2:Enter text...}\"",
            "       Text=\"${3}\"",
            "       Keyboard=\"${4|Default,Text,Numeric,Email,Telephone,Chat,Url|}\"",
            "       ClearButtonVisibility=\"${5|WhileEditing,Never|}\"",
            "       HorizontalOptions=\"${6|Fill,Start,Center,End|}\" />$0"
        ]
    },
    "MAUI Editor (TextArea)": {
        "prefix": ["textarea", "mauieditor", "mauitextarea"],
        "description": "MAUI Editor multi-line text input (equivalent of HTML textarea)",
        "body": [
            "<Editor x:Name=\"${1:myEditor}\"",
            "        Placeholder=\"${2:Enter notes...}\"",
            "        Text=\"${3}\"",
            "        AutoSize=\"${4|TextChanges,Disabled|}\"",
            "        HeightRequest=\"${5:100}\"",
            "        HorizontalOptions=\"${6|Fill,Start,Center,End|}\" />$0"
        ]
    }
}
