{
    "post": {
        "prefix": "post",
        "body": [
            "curl -X POST \"https://example.com/api\" \\",
            "\t-H \"Content-Type: application/json\" \\",
            "\t-d '{",
            "\t\t\"name\": \"John\",",
            "\t\t\"email\": \"john@example.com\"",
            "\t}'"
        ]
    },
    "shebang": {
        "prefix": "shebang",
        "body": ["#!/bin/bash", ""],
        "description": "Add a bash shebang script template"
    },
    "if": {
        "prefix": "if",
        "body": ["if [ ${1:condition} ]; then", "\t$0", "fi"],
        "description": "if statement"
    },
    "ifelse": {
        "prefix": "ifelse",
        "body": ["if [ ${1:condition} ]; then", "\t$0", "else", "\t${2}", "fi"],
        "description": "if-else statement"
    },
    "elif": {
        "prefix": "elif",
        "body": [
            "if [ ${1:condition} ]; then",
            "\t${2}",
            "elif [ ${3:condition} ]; then",
            "\t$0",
            "fi"
        ],
        "description": "if-elif statement"
    },
    "for": {
        "prefix": "for",
        "body": ["for ${1:var} in ${2:list}; do", "\t$0", "done"],
        "description": "for loop"
    },
    "while": {
        "prefix": "while",
        "body": ["while [ ${1:condition} ]; do", "\t$0", "done"],
        "description": "while loop"
    },
    "until": {
        "prefix": "until",
        "body": ["until [ ${1:condition} ]; do", "\t$0", "done"],
        "description": "until loop"
    },
    "case": {
        "prefix": "case",
        "body": [
            "case ${1:var} in",
            "\t${2:pattern1})",
            "\t\t$0",
            "\t\t;;",
            "\t${3:pattern2})",
            "\t\t${4:command}",
            "\t\t;;",
            "\t*)",
            "\t\techo \"Invalid option\"",
            "\t\t;;",
            "esac"
        ],
        "description": "case statement"
    },
    "func": {
        "prefix": "func",
        "body": ["${1:name}() {", "\t$0", "}"],
        "description": "Define a function"
    },
    "read": {
        "prefix": "read",
        "body": ["read -p \"${1:prompt}: \" ${2:var}"],
        "description": "Read user input into a variable"
    },
    "export": {
        "prefix": "export",
        "body": ["export ${1:VAR}=\"${2:value}\""],
        "description": "Export an environment variable"
    },
    "curldownload": {
        "prefix": "curldownload",
        "body": ["curl -OL ${1:https://example.com/file}"],
        "description": "Download a file with curl"
    }
}
