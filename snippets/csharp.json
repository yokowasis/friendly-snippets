{
    "Console.WriteLine": {
        "prefix": "cl",
        "description": "Outputs a message to the console (equivalent of console.log)",
        "body": ["Console.WriteLine($1);$0"]
    },
    "Fetch GET": {
        "prefix": "fetch",
        "description": "HTTP GET request using HttpClient with typed JSON deserialization",
        "body": [
            "public class ${1:MyResponse}",
            "{",
            "    public string ${2:Property} { get; set; }",
            "}",
            "",
            "using var client = new HttpClient();",
            "var ${3:response} = await client.GetAsync(\"${4:https://example.com/api}\");",
            "${3:response}.EnsureSuccessStatusCode();",
            "var ${5:result} = await ${3:response}.Content.ReadFromJsonAsync<${1:MyResponse}>();$0"
        ]
    },
    "Fetch POST with JSON body": {
        "prefix": "fetchpost",
        "description": "HTTP POST request with JSON body and typed response using HttpClient",
        "body": [
            "public class ${1:MyResponse}",
            "{",
            "    public string ${2:Property} { get; set; }",
            "}",
            "",
            "using var client = new HttpClient();",
            "var ${3:response} = await client.PostAsJsonAsync(\"${4:https://example.com/api}\", ${5:payload});",
            "${3:response}.EnsureSuccessStatusCode();",
            "var ${6:result} = await ${3:response}.Content.ReadFromJsonAsync<${1:MyResponse}>();$0"
        ]
    },
    "Try Catch": {
        "prefix": "try",
        "description": "try-catch block with Exception",
        "body": [
            "try",
            "{",
            "    $1",
            "}",
            "catch (Exception ${2:ex})",
            "{",
            "    Console.WriteLine(${2:ex}.Message);$0",
            "}"
        ]
    },
    "Try Catch Finally": {
        "prefix": "trycatch",
        "description": "try-catch-finally block with typed exception",
        "body": [
            "try",
            "{",
            "    $1",
            "}",
            "catch (${2:Exception} ${3:ex})",
            "{",
            "    Console.WriteLine(${3:ex}.Message);$4",
            "}",
            "finally",
            "{",
            "    $0",
            "}"
        ]
    },
    "MAUI Picker Code-Behind (Set Items & Get Value)": {
        "prefix": "mauiselect",
        "description": "MAUI Picker C# code-behind: set items and handle selection changed",
        "body": [
            "// Set items",
            "${1:myPicker}.ItemsSource = new List<string>",
            "{",
            "    \"${2:Option 1}\",",
            "    \"${3:Option 2}\",",
            "    \"${4:Option 3}\"",
            "};",
            "",
            "// Get selected value via event",
            "private void ${5:OnPickerSelectedIndexChanged}(object sender, EventArgs e)",
            "{",
            "    var picker = (Picker)sender;",
            "    if (picker.SelectedIndex != -1)",
            "    {",
            "        string ${6:selectedValue} = picker.SelectedItem?.ToString();$0",
            "    }",
            "}"
        ]
    },
    "MAUI Picker Set Items": {
        "prefix": "mauiselectset",
        "description": "MAUI Picker set items in C#",
        "body": [
            "${1:myPicker}.ItemsSource = new List<string>",
            "{",
            "    \"${2:Option 1}\",",
            "    \"${3:Option 2}\",",
            "    \"${4:Option 3}\"",
            "};$0"
        ]
    },
    "MAUI Picker Get Value": {
        "prefix": "mauiselectget",
        "description": "MAUI Picker get selected value in C#",
        "body": [
            "string ${1:selectedValue} = ${2:myPicker}.SelectedItem?.ToString();$0"
        ]
    },
    "For Loop": {
        "prefix": ["for", "forloop"],
        "description": "for loop (incrementing)",
        "body": [
            "for (int ${1:i} = 0; ${1:i} < ${2:length}; ${1:i}++)",
            "{",
            "    $0",
            "}"
        ]
    },
    "For Reverse Loop": {
        "prefix": ["forr", "forrev"],
        "description": "for loop (decrementing / reverse)",
        "body": [
            "for (int ${1:i} = ${2:length} - 1; ${1:i} >= 0; ${1:i}--)",
            "{",
            "    $0",
            "}"
        ]
    },
    "Foreach Loop": {
        "prefix": ["foreach", "fe"],
        "description": "foreach loop over collection",
        "body": [
            "foreach (var ${1:item} in ${2:collection})",
            "{",
            "    $0",
            "}"
        ]
    },
    "Foreach Loop with Index": {
        "prefix": ["foreachi", "fei"],
        "description": "foreach loop with an index counter",
        "body": [
            "int ${1:i} = 0;",
            "foreach (var ${2:item} in ${3:collection})",
            "{",
            "    $0",
            "    ${1:i}++;",
            "}"
        ]
    },
    "Await Foreach Loop": {
        "prefix": ["foreacha", "awaitforeach"],
        "description": "await foreach loop for IAsyncEnumerable",
