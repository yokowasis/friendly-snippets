        "prefix": "s3",
        "body": [
            "import { S3Client, PutObjectCommand } from '@aws-sdk/client-s3';",
            "import fs from 'node:fs';",
            "import 'dotenv/config';",
            "import mime from 'mime-types';",
            "",
            "// Initialize the S3 client using your custom server variables",
            "const s3Client = new S3Client({",
            "\tendpoint: process.env.S3_ENDPOINT,",
            "\tregion: process.env.S3_REGION,",
            "\tcredentials: {",
            "\t\taccessKeyId: process.env.S3_ACCESS_KEY,",
            "\t\tsecretAccessKey: process.env.S3_SECRET_KEY,",
            "\t},",
            "\tforcePathStyle: true, // Crucial for standalone custom servers like MinIO",
            "});",
            "",
            "/**",
            " * Uploads a local file to a specific destination on a custom S3 server.",
            " * ",
            " * @param {string} localPath - The absolute or relative path to the local file.",
            " * @param {string} destinationKey - The target path/filename inside the S3 bucket.",
            " * @returns {Promise<{success: boolean, url: string, key: string}>}",
            " */",
            "export async function uploadToCustomS3(localPath, destinationKey) {",
            "\t// 1. Structural validations",
            "\tif (!localPath || !destinationKey) {",
            "\t\tthrow new Error('Both localPath and destinationKey parameters are required.');",
            "\t}",
            "",
            "\tif (!fs.existsSync(localPath)) {",
            "\t\tthrow new Error(`Local file not found at path: \"\\${localPath}\"`);",
            "\t}",
            "",
            "\ttry {",
            "\t\t// 2. Stream the file directly to avoid loading large files into memory",
            "\t\tconst fileStream = fs.createReadStream(localPath);",
            "",
            "\t\t/** @type {import('@aws-sdk/client-s3').PutObjectCommandInput} */",
            "\t\tconst uploadParams = {",
            "\t\t\tBucket: process.env.S3_BUCKET_NAME,",
            "\t\t\tKey: destinationKey,",
            "\t\t\tBody: fileStream,",
            "\t\t\tContentType: mime.lookup(localPath) || 'application/octet-stream',",
            "\t\t};",
            "",
            "\t\tconst command = new PutObjectCommand(uploadParams);",
            "\t\tawait s3Client.send(command);",
            "",
            "\t\t// 3. Construct and return useful details",
            "\t\tconst fileUrl = `${process.env.S3_ENDPOINT}/${process.env.S3_BUCKET_NAME}/\\${destinationKey}`;",
            "\t\t",
            "\t\treturn {",
            "\t\t\tsuccess: true,",
            "\t\t\turl: fileUrl,",
            "\t\t\tkey: destinationKey",
            "\t\t};",
            "",
            "\t} catch (error) {",
            "\t\tconsole.error(`Failed uploading \\${localPath} to \\${destinationKey}:`, error);",
            "\t\tthrow error;",
            "\t}",
            "}",
            ""
        ]
    },
